# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ปลอดภัยก่อน deploy จริง
# cp .env.example .env

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=srb_admin
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=srb_cctv_registry

# --- Backend (FastAPI) ---
# สร้างค่าใหม่ด้วย: openssl rand -hex 32
JWT_SECRET=changeme_generate_random_secret
ENVIRONMENT=production
# โดเมนหน้าบ้านที่อนุญาตให้เรียก API ได้ (คั่นด้วย , ถ้ามีหลายโดเมน)
CORS_ORIGINS=https://cctv.saraburi.go.th

# --- Frontend (Vite) ---
# ใช้ตอน build อิมเมจ frontend เท่านั้น (docker compose build.args) ต้องเป็น URL จริงที่ผู้ใช้เข้าถึงได้จากภายนอก
VITE_API_URL=https://cctv.saraburi.go.th/api/v1
VITE_MEDIA_URL=https://cctv.saraburi.go.th/media
