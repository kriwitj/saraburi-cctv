# go2rtc.yaml.example
# คัดลอกไฟล์นี้เป็น go2rtc.yaml แล้วแก้ไขค่าให้เป็นค่าจริงก่อนใช้งาน (ไฟล์ go2rtc.yaml ถูก .gitignore ไว้แล้ว)
# cp go2rtc.yaml.example go2rtc.yaml

api:
  listen: ":1984"

rtsp:
  listen: ":8554"
  username: "changeme_rtsp_username"
  password: "changeme_rtsp_password"

webrtc:
  listen: ":8555"
  candidates:
    - 127.0.0.1
    # ใส่ IP สาธารณะจริงของเซิร์ฟเวอร์เพื่อให้ Client ด้านนอกเข้าเชื่อมต่อ WebRTC ได้
    # - 10.0.0.100

# รายการสตรีมกล้อง (ใส่กล้องจริงเมื่อพร้อมใช้งาน)
streams: {}
  # ตัวอย่างการระบุกล้องจริง
  # srb_muang_001: rtsp://admin:pass1234@192.168.1.100:554/h264Preview_01_main

log:
  level: info
  format: text
